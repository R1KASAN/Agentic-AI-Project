      "typeVersion": 4.2,
      "position": [1950, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/recommendations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"class_id\": \"{{ $node['Get Aggregated Climate Data'].json[0].class_id }}\", \"policy_level\": \"WARNING\", \"ai_message_draft\": \"{{ $json.message_draft }}\", \"actions_json\": {{ JSON.stringify($json.actions) }}, \"confidence_score\": {{ $json.confidence }}, \"reasoning\": \"{{ $json.reasoning }}\", \"inquiry_mode\": {{ $json.inquiry_mode }}, \"fallback_used\": {{ $json.fallback_used || false }}, \"status\": \"PENDING_APPROVAL\", \"priority\": \"HIGH\", \"alert_sent_at\": \"{{ $now.toISO() }}\", \"created_at\": \"{{ $now.toISO() }}\" }",
        "options": {
          "timeout": 15000,
          "retry": { "maxTries": 3, "waitBetweenTries": 2000 }
        }
      },
      "id": "ca-http-insert-warning-013",
      "name": "Insert Draft Recommendation (WARNING)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1950, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RESEND_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"from\": \"{{ $env.EMAIL_FROM }}\", \"to\": \"{{ $env.EMAIL_TEACHER }}\", \"subject\": \"⚠️ [Climate Agent] พบสัญญาณเตือนห้องเรียนวันนี้\", \"html\": \"<div style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;'><h2 style='color: #f59e0b;'>⚠️ สัญญาณเตือนบรรยากาศห้องเรียน</h2><p style='font-size: 16px; line-height: 1.6;'>{{ $json.message_draft }}</p><hr style='border: none; border-top: 1px solid #e5e7eb;'><p style='font-size: 14px; color: #6b7280;'><strong>ข้อเสนอแนะ:</strong></p><ul style='font-size: 14px; color: #374151;'>{{ $json.actions.map(a => '<li>' + a + '</li>').join('') }}</ul><p style='margin-top: 20px;'><a href='{{ $env.DASHBOARD_URL }}' style='background-color: #3b82f6; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block;'>เข้า Dashboard เพื่ออนุมัติ →</a></p><p style='font-size: 12px; color: #9ca3af; margin-top: 20px;'><small>Confidence Score: {{ $json.confidence }}<br>System: Climate Agent v1.0</small></p></div>\" }",
        "options": {
          "timeout": 15000,
          "retry": { "maxTries": 3, "waitBetweenTries": 2000 }
        }
      },
      "id": "ca-email-warning-021",
      "name": "Email Alert - WARNING to Teacher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2150, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/recommendations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"class_id\": \"{{ $node['Get Aggregated Climate Data'].json[0].class_id }}\", \"policy_level\": \"CRITICAL\", \"ai_message_draft\": \"{{ $json.message_draft }}\", \"actions_json\": {{ JSON.stringify($json.actions) }}, \"confidence_score\": {{ $json.confidence }}, \"reasoning\": \"{{ $json.reasoning }}\", \"inquiry_mode\": {{ $json.inquiry_mode }}, \"fallback_used\": {{ $json.fallback_used || false }}, \"status\": \"PENDING_APPROVAL\", \"priority\": \"URGENT\", \"alert_sent_at\": \"{{ $now.toISO() }}\", \"created_at\": \"{{ $now.toISO() }}\" }",
        "options": {
          "timeout": 15000,
          "retry": { "maxTries": 3, "waitBetweenTries": 2000 }
        }
      },
      "id": "ca-http-insert-critical-015",
      "name": "Insert Draft Recommendation (CRITICAL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1950, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RESEND_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"from\": \"{{ $env.EMAIL_FROM }}\", \"to\": \"{{ $env.EMAIL_ADMIN }}\", \"subject\": \"🚨 URGENT [Climate Agent] วิกฤตห้องเรียน - ต้องดำเนินการด่วน\", \"html\": \"<div style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;'><h2 style='color: #dc2626;'>🚨 CRITICAL ALERT - วิกฤตห้องเรียน</h2><p style='font-size: 16px; color: #991b1b; padding: 10px; background-color: #fee2e2; border-radius: 5px;'><strong>ต้องดำเนินการด่วน - Urgent Action Required</strong></p><p style='font-size: 14px; margin-top: 15px; line-height: 1.6;'>{{ $json.message_draft }}</p><table style='width: 100%; border-collapse: collapse; margin: 20px 0;'><tr><td style='padding: 8px; background-color: #f3f4f6; font-weight: bold; border: 1px solid #e5e7eb;'>Average Mood Score:</td><td style='padding: 8px; border: 1px solid #e5e7eb;'>{{ $node['Get Aggregated Climate Data'].json[0].avg_mood_score }}</td></tr><tr><td style='padding: 8px; background-color: #f3f4f6; font-weight: bold; border: 1px solid #e5e7eb;'>Total Responses:</td><td style='padding: 8px; border: 1px solid #e5e7eb;'>{{ $node['Get Aggregated Climate Data'].json[0].total_responses }}</td></tr><tr><td style='padding: 8px; background-color: #f3f4f6; font-weight: bold; border: 1px solid #e5e7eb;'>AI Reasoning:</td><td style='padding: 8px; border: 1px solid #e5e7eb;'>{{ $json.reasoning }}</td></tr></table><p style='margin-top: 20px;'><a href='{{ $env.DASHBOARD_URL }}' style='background-color: #dc2626; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; display: inline-block; font-weight: bold;'>เข้า Dashboard ด่วน →</a></p><p style='font-size: 12px; color: #9ca3af; margin-top: 20px;'><small>Confidence Score: {{ $json.confidence }}<br>System: Climate Agent v1.0<br>Time: {{ $now.toISO() }}</small></p></div>\" }",
        "options": {
