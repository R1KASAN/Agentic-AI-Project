        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"class_id\": \"{{ $node['Get Aggregated Climate Data'].json[0].class_id }}\", \"policy_level\": \"ROUTINE\", \"ai_message_draft\": \"{{ $json.message_draft }}\", \"actions_json\": {{ JSON.stringify($json.actions) }}, \"confidence_score\": {{ $json.confidence }}, \"reasoning\": \"{{ $json.reasoning }}\", \"inquiry_mode\": {{ $json.inquiry_mode }}, \"fallback_used\": {{ $json.fallback_used || false }}, \"status\": \"PENDING_APPROVAL\", \"priority\": \"NORMAL\", \"created_at\": \"{{ $now.toISO() }}\" }",
        "options": {
          "timeout": 15000,
          "retry": { "maxTries": 3, "waitBetweenTries": 2000 }
        }
