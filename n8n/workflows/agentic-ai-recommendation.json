            "id": "tool-enroll-010",
            "name": "Tool: count_enrolled_students",
            "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
            "typeVersion": 1.2,
            "position": [
                1240,
                700
            ]
        },
        {
            "parameters": {
                "name": "get_teacher_action_rate",
                "description": "Calculate the teacher's action rate on AI recommendations (how many were approved/dismissed vs still pending). Input JSON: {\"class_id\": \"<uuid>\"}",
                "workflowId": "={{ $env.TOOL_WORKFLOW_ACTION_RATE }}",
