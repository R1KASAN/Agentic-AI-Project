                    "values": [
                        {
                            "name": "class_id",
                            "stringValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('class_id', 'UUID of the class', 'string') }}"
                        }
                    ]
                }
            },
            "id": "tool-action-rate-011",
            "name": "Tool: get_teacher_action_rate",
            "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
            "typeVersion": 1.2,
            "position": [
                1380,
                700
            ]
        },
        {
            "parameters": {
                "name": "submit_recommendation",
                "description": "Submit a new recommendation for the teacher. Server-side guard rejects if class already has >=3 pending. Returns was_inserted=true if successful. Input JSON: {\"class_id\": \"<uuid>\", \"content\": \"<text in Thai>\", \"category\": \"engagement|wellbeing|collaboration|academic\", \"priority\": \"high|medium|low\"}",
                "workflowId": "={{ $env.TOOL_WORKFLOW_SUBMIT_REC }}",
                "fields": {
                    "values": [
                        {
                            "name": "class_id",
                            "stringValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('class_id', 'UUID of the class', 'string') }}"
                        },
                        {
                            "name": "content",
                            "stringValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('content', 'Recommendation text in Thai', 'string') }}"
                        },
                        {
                            "name": "category",
                            "stringValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('category', 'Category: engagement, wellbeing, collaboration, or academic', 'string') }}"
                        },
                        {
                            "name": "priority",
                            "stringValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('priority', 'Priority: high, medium, or low', 'string') }}"
                        }
                    ]
                }
            },
            "id": "tool-submit-012",
            "name": "Tool: submit_recommendation",
            "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
            "typeVersion": 1.2,
            "position": [
                1520,
                700
            ]
        },
        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const output = $input.item.json;\nconst agentOutput = output.output || output.text || '';\n\nlet parsed;\ntry {\n  const jsonMatch = agentOutput.match(/\\{[\\s\\S]*\\}/);\n  parsed = jsonMatch ? JSON.parse(jsonMatch[0]) : { reasoning: agentOutput };\n} catch(e) {\n  parsed = { reasoning: agentOutput, parse_error: true };\n}\n\nreturn {\n  json: {\n    class_id: parsed.class_id || 'unknown',\n    reasoning: parsed.reasoning || agentOutput,\n    actions_taken: parsed.actions_taken || [],\n    data_quality_notes: parsed.data_quality_notes || '',\n    intermediate_steps: output.intermediateSteps || []\n  }\n};"
            },
            "id": "agent-parse-013",
            "name": "Parse Agent Output",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1220,
                300
            ]
        },
        {
            "parameters": {
                "amount": 4,
                "unit": "seconds"
            },
            "id": "agent-wait-014",
            "name": "Rate Limit Cooldown",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1.1,
            "position": [
                1440,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.NEXT_PUBLIC_APP_URL }}/api/n8n/webhook",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.N8N_WEBHOOK_SECRET }}"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\"event\": \"recommendations_generated\"}",
                "options": {}
            },
            "id": "agent-webhook-015",
            "name": "Notify Webhook",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1660,
                300
            ]
        }
    ],
